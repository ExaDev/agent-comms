        "?room=my-room"
      ],
      "expect": {
        "kind": "room",
        "roomId": "my-room"
      },
      "from": "url-sync.unit.test.ts: parseDeepLink > parses ?room= parameter",
      "function": "url-sync.parseDeepLink",
      "id": "parses-room-parameter",
      "kind": "function"
    },
    {
      "args": [
        "?dm=agent-123"

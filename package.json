{
  "name": "agent-comms",
  "version": "3.25.0",
  "description": "Cross-harness communication mesh for LLM agents — rooms, DMs, presence, and real-time push delivery over TCP",
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/agent-comms.git"
  },
  "homepage": "https://github.com/ExaDev/agent-comms#readme",
  "mcpName": "io.github.ExaDev/agent-comms",
  "bugs": "https://github.com/ExaDev/agent-comms/issues",
  "license": "MIT",
  "keywords": [
    "agent",
    "llm",
    "communication",
    "mesh",
    "mcp",
    "rooms",
    "dm",
    "presence",
    "cross-harness",
    "pi-package"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    ".claude-plugin/",
    "commands/",
    "hooks/"
  ],
  "bin": {
    "agent-comms": "dist/cli.js"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "build:frontend": "turbo run build:frontend:run",
    "build:frontend:run": "vite build --config src/bridges/user/web/vite.config.ts",
    "build": "turbo run build:run",
    "build:run": "tsc && tsx scripts/copy-web-assets.ts && printf '#!/usr/bin/env node\n' | cat - dist/cli.js > dist/cli.tmp && mv dist/cli.tmp dist/cli.js",
    "generate:server-json": "tsx scripts/sync-release-metadata.ts",
    "publish:mcp-registry": "tsx scripts/publish-mcp-registry.ts",
    "lint": "turbo run lint:run",
    "lint:run": "eslint .",
    "test": "turbo run test:run",
    "test:run": "vitest run",
    "test:delivery": "tsx src/test/delivery-receipt.runner.ts",
    "test:smoke": "pnpm build && tsx --test src/test/mesh-smoke.runner.ts",
    "test:all": "pnpm test && pnpm test:delivery && pnpm test:smoke",
    "test:e2e": "turbo run test:e2e:run",
    "test:e2e:run": "playwright test",
    "typecheck": "turbo run typecheck:run",
    "typecheck:run": "tsc --noEmit",
    "mutation": "stryker run stryker.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@exadev/eslint-config": "2.12.3",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@playwright/test": "1.61.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.3.14",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "semantic-release": "25.0.7",
    "tsx": "^4.23.1",
    "turbo": "2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/contract": "2.0.0-beta.35",
    "@orpc/server": "2.0.0-beta.35",
    "cbor2": "2.3.0",
    "cc-peer": "1.5.0",
    "d3-force": "3.0.0",
    "openpgp": "6.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.6",
    "wire-mesh-core": "1.58.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/bridges/pi/extension.ts"
    ]
  }
}

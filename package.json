{
  "name": "agent-comms",
  "version": "1.24.2",
  "description": "Cross-harness communication mesh for LLM agents — rooms, DMs, presence, and real-time push delivery over TCP",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/agent-comms.git"
  },
  "homepage": "https://github.com/ExaDev/agent-comms#readme",
  "mcpName": "io.github.ExaDev/agent-comms",
  "bugs": "https://github.com/ExaDev/agent-comms/issues",
  "license": "MIT",
  "keywords": [
    "agent",
    "llm",
    "communication",
    "mesh",
    "mcp",
    "rooms",
    "dm",
    "presence",
    "cross-harness",
    "pi-package"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    ".claude-plugin/",
    "commands/",
    "hooks/"
  ],
  "bin": {
    "agent-comms": "dist/cli.js"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "build:frontend": "tsx src/bridges/user/web/build.ts",
    "build": "pnpm build:frontend && tsc && printf '#!/usr/bin/env node\n' | cat - dist/cli.js > dist/cli.tmp && mv dist/cli.tmp dist/cli.js",
    "generate:server-json": "tsx scripts/sync-release-metadata.ts",
    "publish:mcp-registry": "tsx scripts/publish-mcp-registry.ts",
    "lint": "eslint .",
    "test": "node --test dist/test/coordinator-socket-error.integration.test.js",
    "test:visibility": "node --test dist/test/visibility.integration.test.js",
    "test:delivery": "node dist/test/delivery-receipt.runner.js",
    "test:all": "pnpm test && pnpm test:delivery",
    "test:frontend": "tsx --test src/bridges/user/web/frontend/test/**/*.unit.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@playwright/test": "1.61.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "@types/ws": "8.18.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "semantic-release": "25.0.7",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "preact": "10.29.7",
    "typebox": "1.3.6",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/bridges/pi/index.ts"
    ]
  }
}

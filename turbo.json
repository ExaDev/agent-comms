{
  "$schema": "https://turborepo.com/schema.json",

  "tasks": {
    "build:frontend:run": {
      "inputs": ["src/bridges/user/web/build.ts", "src/bridges/user/web/frontend/**"],
      "outputs": ["src/bridges/user/web/dist/**"]
    },
    "build:run": {
      "dependsOn": ["build:frontend:run"],
      // Excludes build:frontend:run's own output (nested under src/, since the esbuild bundle lands in src/bridges/user/web/dist/) -- without this, restoring that output on a cache hit changes build:run's own input hash and forces a spurious re-execution.
      "inputs": ["src/**", "!src/bridges/user/web/dist/**", "scripts/copy-web-assets.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "lint:run": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.ts"]
    },
    "typecheck:run": {
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json"]
    },
    "test:run": {},
    "test:e2e:run": {
      // A real browser driving a real server over a real socket -- exactly the kind of run where replaying a stale cached pass could mask a genuine regression in the actual runtime environment, so it's never cached.
      "cache": false,
      "dependsOn": ["build:frontend:run"]
    }
  }
}

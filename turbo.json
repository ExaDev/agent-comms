{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,

  "tasks": {
    "_build": {
      "dependsOn": ["_build:frontend"],
      // Excludes _build:frontend's own output (nested under src/, since the Vite bundle lands in src/bridges/user/web/dist/) -- without this, restoring that output on a cache hit changes _build's own input hash and forces a spurious re-execution.
      "inputs": ["src/**", "!src/bridges/user/web/dist/**", "scripts/copy-web-assets.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "_build:frontend": {
      "inputs": ["src/bridges/user/web/vite.config.ts", "src/bridges/user/web/frontend/**"],
      "outputs": ["src/bridges/user/web/dist/**"]
    },
    "_lint": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.ts"]
    },
    "_prepush": {
      // The checks the pre-push hook runs before its related-tests run. The build is here because the web-bridge
      // integration tests the hook may select need it (see _test), and turbo caches it, so it costs nothing when
      // the frontend sources are unchanged.
      "dependsOn": ["_lint", "_typecheck", "_build:frontend"]
    },
    "_test": {
      // The web-bridge integration tests request the frontend routes, which serve src/bridges/user/web/dist.
      // Without this dependency, a fresh checkout with no prior build (a new worktree running the tests, in
      // particular) gets 503 from those routes and fails those suites rather than actually exercising them.
      "dependsOn": ["_build:frontend"]
    },
    "_test:e2e": {
      // A real browser driving a real server over a real socket -- exactly the kind of run where replaying a stale cached pass could mask a genuine regression in the actual runtime environment, so it's never cached.
      "cache": false,
      "dependsOn": ["_build:frontend"]
    },
    "_typecheck": {
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json"]
    }
  }
}
